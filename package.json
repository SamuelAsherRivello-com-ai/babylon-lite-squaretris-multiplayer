{
  "name": "babylon-lite-tetris-multiplayer-clone",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:config && vite build && node --experimental-strip-types scripts/check-deployment-assets.ts",
    "preview": "vite preview",
    "test": "node --test --test-isolation=none tetris/test/*.test.mjs docs/verification/*.test.mjs tetris/test/page.test.ts",
    "typecheck:config": "tsc -p tsconfig.config.json"
  },
  "dependencies": {
    "@babylonjs/lite": "1.32.0",
    "@rmc/multiplayer-client": "https://github.com/SamuelAsherRivello/rmc-colyseus-multiplayer-server/releases/download/v0.9.12/rmc-multiplayer-client-0.9.12.tgz",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "24.x"
  }
}
